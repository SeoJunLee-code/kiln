# Rotation in 3D. rot turns a box about one axis; quat holds a full orientation and its
# sx sy sz turn it about the world axes. Walk to the gem. Turning is drawn only.
world hz=60 gravity=0,30

entity pilot
  pos 1 -1 6
  box 0.8 1 0.8
  vel
  body
  ctrl 5 0 xz
  eye 0 -7 9
  sprite @ dodgerblue

entity floor
  pos 0 0 0
  box 14 1 10
  solid
  sprite color=dimgray

entity slab
  pos 2 -1.5 1.5
  box 2.4 0.4 1.6
  rot 25 axis=y
  sprite color=peru
entity ramp
  pos 5.5 -1.6 1
  box 2.6 0.3 1.6
  rot 20 axis=z
  sprite color=slategray
entity tumbler
  pos 9 -3 2
  box 1.4 1.4 1.4
  quat sx=40 sy=70 sz=15
  sprite color=tomato
entity tilted
  pos 11.4 -1.9 5.5
  box 1 1.6 1
  quat 0.25882 0 0 0.96593
  sprite color=mediumseagreen
entity top
  pos 4.2 -1.6 6.2
  box 1 1.4 1
  rot spin=120 axis=y
  sprite color=orchid mesh=spire.obj
entity gem
  pos 12.2 -1.2 2.2
  box 0.7 0.9 0.7
  quat sy=180
  trigger pilot gem despawn-self
  sprite * gold mesh=gem.obj

expect gone gem by 600
