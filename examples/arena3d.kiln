# A small 3D room. Walk on the x/z plane, jump (a) onto the step for the gem, reach the exit.
# y grows downward, so things above the floor have negative y.
world hz=60 gravity=0,30

entity hero
  pos 1 -1 1
  box 0.8 1 0.8
  vel
  body
  ctrl 5 10 xz
  eye 0 -8 9
  sprite @ dodgerblue

entity floor
  pos 0 0 0
  box 12 1 12
  solid
  sprite color=dimgray
entity wall
  pos 5 -2 0
  box 1 2 8
  solid
  sprite color=slategray
entity step
  pos 8 -1 8
  box 3 1 3
  solid
  sprite color=peru

entity gem
  pos 9.25 -1.75 9.25
  box 0.5 0.5 0.5
  trigger hero gem despawn-self
  sprite * gold
entity exit
  pos 10 -1 1
  box 1 1 1
  trigger hero win
  sprite E limegreen
entity pit
  pos -4 6 -4
  box 20 1 20
  trigger hero fell
  sprite ~ crimson

expect gone gem by 600
expect event win by 600
expect never hero pit
