# The gap is wider than a jump. A lift paces across it; ride it to the other side.
world hz=60 gravity=0,30

entity hero
  pos 1 4
  box 0.8 1
  vel
  body
  ctrl 4 9
  camera 18 10
  sprite @

entity left
  pos 0 5
  box 4 1
  solid
entity right
  pos 12 5
  box 5 1
  solid
entity lift
  pos 4 5
  box 2 0.5
  solid
  vel
  pace x 4 10 2
  sprite = sienna

entity pit
  pos -5 9
  box 30 1
  trigger hero fell
  sprite ~ crimson
entity flag
  pos 15 4
  box 1 1
  trigger hero win
  sprite F limegreen

expect event win by 900
expect never hero pit
