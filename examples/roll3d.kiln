# A ball rolled by the keys, with rules and no script: a ramp that is a turned solid,
# three lives, 20 seconds a try, falling off starts the try again, the score over the 3D view.
world hz=60 gravity=0,20 physics=rapier
entity floor
  pos -3 1 -3
  box 6 1 12
  solid
  sprite color=slategray
entity ramp
  pos -1.5 0.2 -8.6
  box 3 0.4 6
  solid
  rot -20 axis=x
  sprite color=peru
entity top
  pos -3 -0.8 -12.5
  box 6 1 4
  solid
  sprite color=slategray
entity ball
  pos -0.4 0.2 6
  box 0.8 0.8 0.8
  rigid ball damp=0.4 spin=0.4
  drive 14 top=7
  sprite color=crimson
  eye 0 -4 7
entity gem
  pos -0.25 0.3 2
  box 0.5 0.5 0.5
  trigger ball gem despawn-self
  sprite color=gold
entity goal
  pos -1 -1.4 -12
  box 2 0.6 2
  trigger ball win despawn-other
  sprite color=limegreen
entity pit
  pos -40 8 -40
  box 80 1 80
  trigger ball fell
entity lives
  pin top-right -0.3 0.3
  label Lives_%
  tally fell 3 -1 then=dead
entity score
  pin top-left 0.3 0.3
  label Gems_%
  tally gem
entity clock
  pin top 0 0.3
  label Time_%
  timer 20 fell
entity again
  when fell reset:all
expect event gem by 400
expect event win by 900
expect count fell == 0 at 900
