# First of two levels. The stairs load the next scene (`load:level2.kiln`).
world hz=60

prefab hero
  box 0.8 0.8
  vel
  ctrl 4
  sprite @
prefab coin
  box 0.5 0.5
  tag coin
  trigger hero coin despawn-self
  sprite o gold
prefab stairs
  box 0.8 0.8
  trigger hero stairs load:level2.kiln
  sprite > limegreen
  label next_level limegreen

entity map
  pos 0 0
  tiles spawn=@:hero,o:coin,>:stairs
    #########
    #@..o...#
    #.###.#.#
    #...o.#>#
    #########

# The coins counted so far. `keep` hands the number on to the next level.
entity score
  pos 7 0.9
  label Coins:_% gold
  tally coin
  keep tally

# Sounds for the player in a browser; a headless run ignores them (guide audio).
entity audio
  sound coin:coin.wav,load:door.wav music=tune.wav mvol=0.4

entity title
  pos 4.5 0.9
  label Level_1

expect gone #coin by 600
expect event load by 600
expect count coin == 2 at 600
