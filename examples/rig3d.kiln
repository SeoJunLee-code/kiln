# A skinned model and a moving node, both exported by Godot (see ASSETS.md), played by
# `clip`. What a model shows is a function of the tick, so the pictures replay; none of it
# touches the simulation. WebGPU draws it; the WebGL2 fallback shows each as its box.
world hz=60 gravity=0,30

entity walker
  pos 0 -0.8 5.4
  box 0.6 0.8 0.6
  vel
  body
  ctrl 4 0 xz
  eye 0 -3.5 6.5
  sprite @ dodgerblue

entity floor
  pos -5 0 -1
  box 12 1 9
  solid
  sprite color=dimgray

entity reed
  pos -2.6 -3 1.5
  box 1.35 3 0.5
  sprite mesh=bend.glb
  clip bend

entity late_reed
  pos 0 -3 1.5
  box 1.35 3 0.5
  sprite mesh=bend.glb
  clip bend from=30

entity signal
  pos 2.6 -3 1.5
  box 1.35 3 0.5
  sprite mesh=bend.glb
  clip wave speed=0.5

entity stop
  pos 0.1 -1 3.4
  box 0.4 1 0.4
  trigger walker arrived

expect event arrived by 300
