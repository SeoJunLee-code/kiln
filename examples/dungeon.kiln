# The whole level is one picture. Characters listed in `spawn` become entities.
world hz=60

prefab hero
  box 0.8 0.8
  vel
  ctrl 4
  sprite @
prefab coin
  box 0.5 0.5
  tag coin
  trigger hero coin despawn-self
  sprite o gold
prefab door
  box 0.8 0.8
  trigger hero win
  sprite D limegreen

entity map
  pos 0 0
  tiles spawn=@:hero,o:coin,D:door
    #########
    #@..#..o#
    #.#.#.#.#
    #o#...#D#
    #.#####.#
    #...o...#
    #########

expect gone #coin by 600
expect event win by 600
