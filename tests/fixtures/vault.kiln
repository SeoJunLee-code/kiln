# A level the first agent run could not get solved (proof/lite/RUN.md, failures 2 to 5):
# four gems in a maze, two guards, and a door that opens when the gems are gone.
# Straight-line distance points through walls here, and a guard must never be touched.
world hz=60
use ./vault.ts

entity map
  pos 0 0
  tiles
    ###########
    #...#.....#
    #.#...###.#
    #####.#####
    #.........#
    #####.#####
    #.........#
    #.###.###.#
    #....#.....
    ###########

entity door
  pos 10 8
  box 1 1
  solid
  door

entity exit
  pos 10 8
  box 1 1
  trigger hero exit

entity gem1
  pos 9.25 1.25
  box 0.5 0.5
  tag gem
  trigger hero gem despawn-self
entity gem2
  pos 1.25 6.25
  box 0.5 0.5
  tag gem
  trigger hero gem despawn-self
entity gem3
  pos 9.25 6.25
  box 0.5 0.5
  tag gem
  trigger hero gem despawn-self
entity gem4
  pos 1.25 8.25
  box 0.5 0.5
  tag gem
  trigger hero gem despawn-self

entity hero
  pos 1.15 1.15
  vel
  box 0.7 0.7
  ctrl 4

entity guard1
  pos 1.1 4.1
  vel
  box 0.8 0.8
  pace x 1.1 9.1 3
  trigger hero caught
entity guard2
  pos 9.1 6.1
  vel
  box 0.8 0.8
  pace x 2.1 9.1 2.5
  trigger hero caught

expect gone #gem by 1500
expect event exit by 1500
expect count caught == 0 at 1500
