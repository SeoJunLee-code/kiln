# D: never push a crate. Take gem1, walk down to the crate that covers the pocket,
# stop beside it and try every way toward the hidden gem (gem4) that is not a push.
0 right down
10 right up
10 down down
20 down up
20 right down
30 right up
30 down down
40 down up
40 right down
60 right up
60 down down
100 down up
100 left down
110 left up
# beside crate1: walls above and below
120 down down
150 down up
150 up down
180 up up

expect count gem == 1 at 600
expect count gem4 == 0 at 600
expect never hero gem4
expect never hero #guard
expect at 600 crate1.pos.x == 3
expect at 600 crate1.pos.y == 7
expect at 600 crate2.pos.x == 6
expect at 600 lock4.pos.x == 12
expect at 600 hero.pos.x < 4.5
expect at 600 hero.pos.y > 6.9
expect count load == 0 at 600
