world hz=60 gravity=0,0

entity map
  pos 0 0
  tiles
    ###########
    #....#....#
    #....#....#
    #....#....#
    #.........#
    #....#....#
    #....#....#
    #....#.....
    ###########

entity title
  pos 5.5 0
  label Level_2

entity hero
  pos 1.1 1.1
  vel
  box 0.8 0.8
  ctrl 6
  sprite glyph=@ color=deepskyblue

entity gem1
  pos 2.3 3.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock1
  sprite glyph=* color=magenta

entity gem2
  pos 9.3 1.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock2
  sprite glyph=* color=magenta

entity gem3
  pos 8.3 6.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock3
  sprite glyph=* color=magenta

entity gem4
  pos 1.3 7.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock4
  sprite glyph=* color=magenta

# guards: touching one reloads this level
entity guard1
  pos 6.1 1.1
  vel 0 3
  box 0.8 0.8
  pace y 1.1 7.1 3
  tag guard
  trigger hero caught load:level2.kiln
  sprite glyph=G color=red

entity guard2
  pos 4.1 5.1
  vel -3 0
  box 0.8 0.8
  pace x 1.1 4.1 0
  tag guard
  trigger hero caught load:level2.kiln
  sprite glyph=G color=red

entity exit
  pos 10.2 7.2
  box 0.6 0.6
  trigger hero exit load:level3.kiln
  sprite glyph=> color=lime

entity lock1
  pos 10 7
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

entity lock2
  pos 10 7
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

entity lock3
  pos 10 7
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

entity lock4
  pos 10 7
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

expect gone #gem by 1800
expect gone #door by 1800
expect reach hero exit by 1800
expect never hero #guard
expect event load by 1800
