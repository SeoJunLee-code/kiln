world hz=60 gravity=0,0

entity map
  pos 0 0
  tiles
    #########
    #...#...#
    #...#...#
    #........
    #..##...#
    #.....#.#
    #########

entity title
  pos 4.5 0
  label Level_1

entity hero
  pos 1.1 1.1
  vel
  box 0.8 0.8
  ctrl 6
  sprite glyph=@ color=deepskyblue

# one gem each; every gem removes its own lock from the door
entity gem1
  pos 7.3 1.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock1
  sprite glyph=* color=magenta

entity gem2
  pos 1.3 5.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock2
  sprite glyph=* color=magenta

entity gem3
  pos 7.3 5.3
  box 0.4 0.4
  tag gem
  trigger hero gem despawn-self+despawn:lock3+despawn:lock2
  sprite glyph=* color=magenta

entity exit
  pos 8.2 3.2
  box 0.6 0.6
  trigger hero exit load:level2.kiln
  sprite glyph=> color=lime

# the closed door: stacked locks, open once all are gone
entity lock1
  pos 8 3
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

entity lock2
  pos 8 3
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

entity lock3
  pos 8 3
  box 1 1
  solid
  tag door
  sprite glyph=D color=saddlebrown

expect gone #gem by 900
expect gone #door by 900
expect reach hero exit by 900
expect event load by 900
